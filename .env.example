# Core / control plane
HOST=127.0.0.1
PORT=7070
PUBLIC_BASE_URL=http://127.0.0.1:7070
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
QA_MASTER_KEY=replace-with-a-long-random-secret
WORKER_CONCURRENCY=4
DISTRIBUTED_MODE=false

# Distributed workers. If omitted, derived from QA_MASTER_KEY.
# QA_WORKER_TOKEN=replace-with-a-long-random-worker-token
# QA_CONTROL_PLANE_URL=http://qa-control:7070
# QA_WORKER_CAPABILITIES=api_collection,performance,database,playwright,capture,katalon,jmeter,contract,accessibility,mobile_appium
WORKER_LEASE_SECONDS=180

# Storage
# QA_DATA_DIR=/var/lib/qa-superpower/data
# QA_ARTIFACT_DIR=/var/lib/qa-superpower/artifacts
# QA_GIT_DIR=/var/lib/qa-superpower/data/git-repos

# AI requirement / visual regression / autonomous agent
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6
# VISUAL_AI_MODEL=gpt-5.6
# AGENT_MODEL=gpt-5.6

# Authorized QA/staging targets only. Remote hosts are blocked by default.
ENABLE_REMOTE_TARGETS=false
# ALLOWED_TARGET_HOSTS=staging.example.com,api-staging.example.com,appium.internal.example.com

# Browser
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
RECORDER_STREAM_MS=700
MAX_RECORDER_SESSIONS=5

# Third-party/self-hosted integration hostname allowlist.
# Atlassian Cloud (*.atlassian.net), Xray Cloud and Zephyr Scale use their known defaults.
# INTEGRATION_ALLOWED_HOSTS=jenkins.internal.example.com,gitlab.internal.example.com

# Optional public mock protection
# QA_MOCK_KEY=replace-me

# Reverse proxy only: trust X-Forwarded-Proto when set to true.
TRUST_PROXY=false

# Optional database/execution CLIs
# PSQL_BIN=psql
# MYSQL_BIN=mysql
# KATALON_BIN=/opt/katalon/katalonc
# JMETER_BIN=/opt/jmeter/bin/jmeter
